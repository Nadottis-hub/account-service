# This file is the single source of local config: compose loads it through
# `env_file:`, and uvicorn/alembic/pytest read it directly when run on the host.
#
# Postgres connection string. The value below is the HOST one (localhost, via the
# port compose maps). Inside the container compose overrides it with @db:5432 —
# "db" being the service name — so do not be surprised by the mismatch there.
# Railway: paste the reference ${{Postgres.DATABASE_URL}} — the plain postgresql://
# scheme and any ?sslmode= parameter are normalised for asyncpg in app/config.py.
DATABASE_URL=postgresql+asyncpg://root:root@localhost:5432/account_service

# Signing secret for the Clerk webhook endpoint, from the Clerk dashboard:
# Configure -> Webhooks -> your endpoint -> Signing Secret. Starts with "whsec_".
# Without it the service refuses every webhook with a 500.
CLERK_WEBHOOK_SECRET=whsec_replace_me

LOG_LEVEL=INFO

# "local" enables /docs; anything else disables it.
ENV=local

PORT=8000

# Only used by the test suite. Must be a DIFFERENT database: the suite drops and
# recreates every table between tests.
TEST_DATABASE_URL=postgresql+asyncpg://root:root@localhost:5432/account_service_test
